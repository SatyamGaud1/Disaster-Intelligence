# ==============================================================================
# Disaster Intelligence Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' before running in production or development.
# IMPORTANT: DO NOT COMMIT REAL KEYS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Settings
PORT=5000
HOST=127.0.0.1

# Database Configuration (Relative to project root or absolute path)
DATABASE_PATH=data/disaster_intel.db

# Free / Open Public Dataset Settings (Future module placeholders)
# NASA FIRMS (Free MapKey for open active fire observations):
# Obtain free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=your_free_nasa_firms_key_here

# Open-Meteo & OpenStreetMap do not require API keys.

